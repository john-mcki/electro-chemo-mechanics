# Model Constants (for reference check calculation tab in NMC parameters google sheet)

# Geometry is currently hard-coded
set Model constant offset = 1e-4, DOUBLE

set Model constant c0 = 0.99, DOUBLE
set Model constant c_ref = 0.99, DOUBLE
set Model constant diffusivity = 0.01, DOUBLE

set Model constant i_0 = 10.0, DOUBLE
# Reference OCV at c0=0.99: polynomial evaluated at t=1 gives ~3.302 V.
# del_phi is the overpotential above this reference; eta = F*(del_phi - delta_U_ocv).
set Model constant V_ref = 3.302, DOUBLE
set Model constant del_phi = 3.35, DOUBLE
set Model constant V_min = 0.100, DOUBLE
set Model constant V_max = 4.50, DOUBLE
set Model constant delta_X_Li = 0.7, DOUBLE
set Model constant C_rate = 5.0, DOUBLE
set Model constant V_step = 10.0, DOUBLE

#Mechanics Parameters
set Model constant vegard = 0.02, DOUBLE
set Model constant site_volume = 2.38e-5, DOUBLE
set Model constant stiffness = (200.0,0.3), isotropic elastic constants
# Scaling stress to GPa
set Model constant stress_scale = 1.0e9, DOUBLE
set Model constant RT = 2494.2, DOUBLE
set Model constant F = 96485.0, DOUBLE


